#compdef trames trames-dev
_trames() {
    local -a environments
    case "$words[CURRENT-1]" in
        -e|--environment) environments=("${(@f)$($words[1] env ls -q 2>/dev/null)}"); _describe environment environments ;;
        env) _values command ls create start stop restart enable disable setup status terminal packages configure import-store backup restore check delete doctor ;;
        config) _values command get set unset list edit path --global ;;
        session) _values command ls attach ;;
        completion) _values shell bash zsh fish ;;
        *) _values command shell exec env config session gui completion --environment --help --version ;;
    esac
}
if [[ $ZSH_EVAL_CONTEXT == *:file ]]; then
    compdef _trames trames trames-dev
else
    _trames "$@"
fi
